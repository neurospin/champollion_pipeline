# Coverage config for the `test-cortical-tiles` pixi task only.
# The task runs with cwd = external/cortical_tiles.
[run]
# Anchored at the pipeline root so nothing is written into the submodule;
# the ../.. fallback is the pipeline root from the task cwd.
data_file = ${PIXI_PROJECT_ROOT-../..}/.coverage-cortical-tiles
omit =
    # Dead for coverage; kept upstream by user decision 2026-10-06 (TASK-131 deleted the other nine).
    */cortical_tiles/brainvisa/utils/generate_spam_graph.py
    */cortical_tiles/brainvisa/utils/convert_volume_to_bucket.py
    */cortical_tiles/brainvisa/utils/display_reconstructions.py
    */cortical_tiles/brainvisa/utils/mask_qc.py
    */cortical_tiles/brainvisa/utils/write_distance_map.py
    */cortical_tiles/brainvisa/utils/generate_spam_sulcal_region.py
    */cortical_tiles/brainvisa/utils/suppress_files_from_csv.py
    # Extremities: dead for champollion_V1 since 770a5b74; outside TASK-131's decision, keep-or-delete still open.
    */cortical_tiles/brainvisa/generate_extremities.py
    */cortical_tiles/brainvisa/mask_resampled_extremities.py
    */cortical_tiles/brainvisa/utils/skeleton_extremities.py
    # No live importer (audit in TASK-137); outside TASK-131's decision, keep-or-delete still open.
    */cortical_tiles/utils/pytorchtools.py
    */cortical_tiles/preprocessing/generate_numpy_array.py
    */cortical_tiles/utils/save_results.py
