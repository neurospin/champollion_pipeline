# Shared settings of the rosette container end-to-end runs (E2ECI epic).
#
# Single owner of the rosette paths, the local state paths, the open-data
# allowlist and the tier table. Every scripts/e2e/ tool reads its values from
# here; no other file restates them. Sourced by bash with `set -a`; read from
# Python by scripts/e2e/e2e_env.py. Plain assignments only: no `export`, no
# command substitution. Never put a token, password or key in this file.

# --- rosette layout ----------------------------------------------------------
E2E_ROSETTE_ROOT=/neurospin/dico/bdrabczuk/champollion_e2e
E2E_SIFS_DIR=${E2E_ROSETTE_ROOT}/sifs
E2E_DATA_DIR=${E2E_ROSETTE_ROOT}/data
E2E_RUNS_DIR=${E2E_ROSETTE_ROOT}/runs
E2E_REPORTS_DIR=${E2E_ROSETTE_ROOT}/reports
E2E_CODE_DIR=${E2E_ROSETTE_ROOT}/code

# --- local state ---------------------------------------------------------------
E2E_STATE_DIR=${HOME}/.local/state/champollion_e2e
E2E_LAST_QUICK_GATED_FILE=${E2E_STATE_DIR}/last_quick_gated
E2E_LOCAL_REPORTS_DIR=${E2E_STATE_DIR}/reports

# --- names (Python str.format placeholders) ------------------------------------
E2E_ENV_SIF_NAME="champollion-env-{key12}.sif"
E2E_CODE_DIR_NAME="{commit12}"
E2E_REPORT_RELPATH="{commit12}/{tier}-{layout}/report.json"

# --- env SIF ---------------------------------------------------------------------
# pixi version baked into the env SIF; single source for the Dockerfile.base build
# argument and an input of scripts/e2e/env_key.sh.
E2E_PIXI_VERSION=0.80.0

# --- models and run options ----------------------------------------------------
# Read-only bind; no Hugging Face download, so no token.
E2E_MODELS_DIR=/neurospin/dico/bdrabczuk/models/Champollion_V1/canonical_corrected_26_1
E2E_HF_ENABLED=false
E2E_ENV_SIF_KEEP=3
E2E_WIP_BRANCH=WIP
E2E_RUN_PROFILE_DIRNAME=profile

# --- open data allowlist (IXI, part of OpenBHB) --------------------------------
E2E_IXI_RAWDATA=/neurospin/psy/ixi/rawdata
E2E_IXI_MORPHOLOGIST_DIR=/neurospin/psy/ixi/derivatives/morphologist-2021/subjects
E2E_ALLOWED_DATA_ROOTS="${E2E_IXI_RAWDATA} ${E2E_IXI_MORPHOLOGIST_DIR}"
E2E_IXI_T1_GLOB="sub-*/ses-V1/anat/*_T1w.nii.gz"
E2E_DATA_LICENSE="CC BY-SA 3.0"
# Space-separated regexes, matched case-insensitively anywhere in a path;
# a match refuses the path even inside an allowed root.
E2E_BANNED_DATA_PATTERNS="demo01 ukb uk[^a-z0-9]*bio[^a-z0-9]*bank"

# --- tiers ---------------------------------------------------------------------
E2E_TIERS="quick nightly weekly"
E2E_MAIN_GATE_TIERS="quick nightly"

E2E_TIER_QUICK_TRIGGER=pre-push
E2E_TIER_QUICK_SUBJECTS="sub-002 sub-012"
E2E_TIER_QUICK_LAYOUTS="bids classic"
E2E_TIER_QUICK_STAGES="1 2 3 4 5 6"
E2E_TIER_QUICK_INPUT=raw
E2E_TIER_QUICK_MODE=foreground
E2E_TIER_QUICK_RESUMABLE=no
E2E_TIER_QUICK_TIMEOUT_S=7200

E2E_TIER_NIGHTLY_TRIGGER=nightly
E2E_TIER_NIGHTLY_SUBJECTS=cohort
E2E_TIER_NIGHTLY_LAYOUTS="bids classic"
E2E_TIER_NIGHTLY_STAGES="2 3 4 5 6"
E2E_TIER_NIGHTLY_INPUT=existing-morphologist
E2E_TIER_NIGHTLY_MODE=detached
E2E_TIER_NIGHTLY_RESUMABLE=yes

E2E_TIER_WEEKLY_TRIGGER=weekly
E2E_TIER_WEEKLY_SUBJECTS=cohort
E2E_TIER_WEEKLY_LAYOUTS="bids classic"
E2E_TIER_WEEKLY_STAGES="1 2 3 4 5 6"
E2E_TIER_WEEKLY_INPUT=raw
E2E_TIER_WEEKLY_MODE=detached
E2E_TIER_WEEKLY_RESUMABLE=yes
