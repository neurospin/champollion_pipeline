# Env-only image of the e2e runs: the locked default pixi environment and nothing else
# (no pipeline code, no data, no secret, no user account). Built by build_env_sif and the CI
# workflow with --build-arg PIXI_VERSION and --build-arg PIXI_SHA256, both from scripts/e2e/e2e.env.
# The pipeline code is bound read-only at /opt/code at run time (pack_code layout).

# ubuntu:22.04 multi-arch index digest (docker buildx imagetools inspect, 2026-10-30)
FROM --platform=linux/amd64 ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

ARG PIXI_VERSION
ARG PIXI_SHA256
ARG DEBIAN_FRONTEND=noninteractive

# System deps; versions are the apt-cache policy candidates inside the pinned base (2026-10-30).
# git: cortical_tiles logs.py reads HEAD through gitpython on the stub repository of the code dir.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates=20260816ubuntu0.22.04.1 \
    curl=7.81.0-1ubuntu1.30 \
    git=1:2.34.1-1ubuntu1.18 \
    libgl1-mesa-glx=23.0.4-0ubuntu1~22.04.1 \
    libglib2.0-0=2.72.4-0ubuntu2.10 \
    libxrender1=1:0.9.10-1build4 \
    libxext6=2:1.3.4-1build1 \
    xvfb=2:21.1.4-2ubuntu1.7~22.04.16 \
    && rm -rf /var/lib/apt/lists/*

# pixi: the uncompressed musl release binary, checked against its sha256 before first use
RUN : "${PIXI_VERSION:?build arg PIXI_VERSION required}" \
    && : "${PIXI_SHA256:?build arg PIXI_SHA256 required}" \
    && curl -fsSL "https://github.com/prefix-dev/pixi/releases/download/v${PIXI_VERSION}/pixi-x86_64-unknown-linux-musl" -o /usr/local/bin/pixi \
    && echo "${PIXI_SHA256}  /usr/local/bin/pixi" | sha256sum --check --strict - \
    && chmod 0755 /usr/local/bin/pixi

# The build sees no GPU: select the linux-64-cuda platform of pixi.lock (the cuda floor of pixi.toml)
ENV CONDA_OVERRIDE_CUDA=12.0

WORKDIR /opt/pixi
COPY pixi.toml pixi.lock /opt/pixi/

# chmod in the same RUN: in a later one it would copy the environment into a second layer
RUN PIXI_CACHE_DIR=/tmp/pixi-cache pixi install --locked -e default \
    && rm -rf /tmp/pixi-cache \
    && chmod -R a+rX /opt/pixi

RUN PYTHONDONTWRITEBYTECODE=1 pixi run python -c "import torch, soma.aims, p_tqdm; assert torch.version.cuda, 'torch built without CUDA'"

# Runtime activation; pixi itself never runs at run time (read-only image, any uid, no network)
RUN pixi shell-hook -e default --shell bash > /opt/pixi/activate.sh \
    && chmod 0644 /opt/pixi/activate.sh

ENV PATH=/opt/pixi/.pixi/envs/default/bin:${PATH}
ENV PYTHONPATH=/opt/code/src:/opt/code/external/champollion_V1:/opt/code/external/cortical_tiles:/opt/code/champollion_utils/src
